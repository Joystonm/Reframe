# Server only. Never prefix secrets with VITE_.
GMI_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_API_KEY=
# Remote assets: cloud name + unsigned preset, OR cloud name + signed API credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=reframe
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Mount a Railway persistent volume here.
DATA_DIR=./data
PORT=3001

# Exact Vercel frontend origin, without a trailing slash.
FRONTEND_ORIGIN=
